# Port to bind (Render automatically sets PORT=10000)
PORT=4173

# Secret for signing JWT authentication tokens
JWT_SECRET=billpro-super-secret-key-change-in-production

# Custom SQLite database location (optional; defaults to ./data/billpro.db)
# BILLPRO_DATA_DIR=/var/data
# BILLPRO_DB=/var/data/billpro.db

# Environment mode
NODE_ENV=production
